-      >
-        <span aria-hidden style={{ fontSize: 18 }}>🔔</span>
-        {unreadCount > 0 && (
-          <span style={{
-            position: 'absolute', top: 4, right: 6,
-            background: 'var(--aq-error)', color: '#fff',
-            minWidth: 16, height: 16, borderRadius: 999,
