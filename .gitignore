# Dependencies (Vercel installs these from package.json)
node_modules/
npm/

# Next.js build output
.next/
.next-old/
.next-old2/
*.tsbuildinfo

# Local env (contains secrets — set these in Vercel dashboard instead)
.env.local
.env*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Delivery drop folders — never the app.
#
# These are working copies dropped here to be reviewed and then merged in.
# They are stale duplicates of app/, components/ and lib/, and they do not
# compile: aq-report/ and aq-ship/ import components that were renamed
# months ago. tsconfig.json includes **/*.ts, so if they are ever committed
# `next build` type-checks them and Vercel fails.
#
# This is not hypothetical — it happened. A .gitignore shipped in a tarball
# replaced this file instead of adding to it, these three lines went with
# it, and 78 files landed in the repo on the next `git add -A`. tsconfig
# now excludes them as well, so the build survives even if the ignore is
# lost again.
aq-*/
_to_delete/

# Compiled output of the pure libs, rebuilt by `npm test` on every run
.test-build/
