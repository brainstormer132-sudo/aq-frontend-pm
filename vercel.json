{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "crons": [
    { "path": "/api/asana/sync", "schedule": "0 6 * * *" },
    { "path": "/api/contracts/chase", "schedule": "0 7 * * *" },
    { "path": "/api/finance/payments-due", "schedule": "30 7 * * *" },
    { "path": "/api/registry/expiry-check", "schedule": "0 8 * * *" }
  ],

  "rewrites": [
    {
      "source": "/contracts/api/:path*",
      "destination": "https://aq-backend-1.onrender.com/api/:path*"
    },
    {
      "source": "/contracts/health",
      "destination": "https://aq-backend-1.onrender.com/api/health"
    },
    {
      "source": "/portals",
      "destination": "/portals.html"
    },
    {
      "source": "/invite",
      "destination": "/invite.html"
    }
  ],

  "headers": [
    {
      "source": "/contracts/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
