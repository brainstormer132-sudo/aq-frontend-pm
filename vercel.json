{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/contracts/api/:path*",
      "destination": "https://aq-backend-p5zd.onrender.com/api/:path*"
    },
    {
      "source": "/contracts/health",
      "destination": "https://aq-backend-p5zd.onrender.com/api/health"
    },
    {
      "source": "/portals",
      "destination": "/portals.html"
    },
    {
      "source": "/hub",
      "destination": "/hub.html"
    },
    {
      "source": "/invite",
      "destination": "/invite.html"
    }
  ],

  "headers": [
    {
      "source": "/contracts/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/contracts/:asset(.+\\.(?:js|css|svg|png|jpg|jpeg|webp|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
