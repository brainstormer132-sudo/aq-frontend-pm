# Every environment variable this app reads, and nothing else.
#
# No values. Copy to .env.local for local work; set the same names in the
# Vercel project for a deployment. .env.local is gitignored and must stay
# that way - two of the keys below are enough to read and write everything.
#
# This file is generated from the code, not from memory: it lists exactly
# the names that appear as process.env.* anywhere under app/, lib/, hooks/,
# middleware.ts and scripts/. If you add a new one, add it here too - the
# next person setting up a new environment has nothing else to go on.

# ---------------------------------------------------------------------
# Supabase - required. Nothing works without these three.
# ---------------------------------------------------------------------

# Project URL and the public anonymous key. NEXT_PUBLIC_ means they are
# compiled into the browser bundle, so the anon key is public by design and
# is not a secret - row-level security is what protects the data, not this
# key. Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. This one IS a secret: it bypasses row-level
# security entirely. Server-side only - lib/supabase-admin.ts is the only
# thing that reads it, and it is used by the four cron routes. Never give
# it the NEXT_PUBLIC_ prefix and never put it in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# The FastAPI backend on Render - required for the portals and the seven
# internal screens that reach it.
# ---------------------------------------------------------------------

# Base URL of the contract backend. Falls back to http://127.0.0.1:8000
# when unset, which is right for local work and wrong everywhere else.
# In production the browser does not use this directly: vercel.json
# rewrites /contracts/api/* to the backend, which keeps it same-origin.
NEXT_PUBLIC_CONTRACT_API_URL=

# ---------------------------------------------------------------------
# Cron routes - required in any deployment that has the vercel.json crons.
# ---------------------------------------------------------------------

# Shared secret for the four scheduled routes (asana/sync,
# contracts/chase, finance/payments-due, registry/expiry-check). Each one
# refuses every request whose Authorization header is not exactly
# `Bearer ${CRON_SECRET}`, and refuses ALL of them when this is unset -
# so an unset value is closed, not open. Vercel sends this header on its
# own cron invocations when the variable exists in the project.
CRON_SECRET=

# ---------------------------------------------------------------------
# Asana import - only needed if /api/asana/sync runs. Leave blank to
# disable it; the route fails rather than importing nothing silently.
# ---------------------------------------------------------------------

ASANA_PAT=
ASANA_PROJECT_GID=

# Optional: the workspace campaigns are imported into. Unset means null,
# which the importer treats as "work it out from the data".
ASANA_WORKSPACE_ID=

# A direct Postgres connection string, used ONLY by /api/asana/sync for
# the bulk upsert - PostgREST is the wrong tool for a few thousand rows.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------
# Local development only - never set in Vercel.
# ---------------------------------------------------------------------

# Where `npm run db:test` replays the migrations. It must be a throwaway
# database: the script applies every migration to whatever this points at,
# and it refuses any URL that is not localhost/127.0.0.1. Defaults to
# postgres://postgres@localhost:5432/aq_migration_test.
PGURL=
